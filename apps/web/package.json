{
  "name": "@guildmaster/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "build:pages": "tsc -p tsconfig.json && vite build --mode github-pages",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run src",
    "test:e2e": "playwright test",
    "test:e2e:offline": "vite build && playwright test -c playwright.offline.config.ts",
    "test:e2e:pages": "pnpm build:pages && playwright test -c playwright.pages.config.ts"
  },
  "dependencies": {
    "@guildmaster/content-base": "workspace:*",
    "@guildmaster/content-base-helpers": "workspace:*",
    "@guildmaster/content-base-rules": "workspace:*",
    "@guildmaster/content-custom-adventurers": "workspace:*",
    "@guildmaster/content-custom-adventurers-rules": "workspace:*",
    "@guildmaster/game-ai": "workspace:*",
    "@guildmaster/game-engine": "workspace:*",
    "@guildmaster/game-protocol": "workspace:*",
    "@guildmaster/presentation-core": "workspace:*",
    "@guildmaster/presentation-custom-adventurers": "workspace:*",
    "@guildmaster/presentation-demo": "workspace:*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.0",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  }
}

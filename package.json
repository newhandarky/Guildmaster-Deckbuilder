{
  "name": "guildmaster-deckbuilder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "pnpm --filter @guildmaster/web dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint . --max-warnings=0",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:content-workflow": "node scripts/check-content-verification-workflow.mjs",
    "test": "pnpm -r --if-present test",
    "test:watch": "pnpm --filter @guildmaster/game-engine test:watch",
    "test:e2e": "pnpm --filter @guildmaster/web test:e2e",
    "check": "pnpm typecheck && pnpm lint && pnpm check:architecture && pnpm check:content-workflow && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "eslint": "^9.18.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.18",
    "globals": "^15.14.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.20.0"
  }
}
